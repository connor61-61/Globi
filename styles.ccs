/* ==========================================================================
   WORLD EXPLORER — beta
   Design concept: a field-journal atlas. Parchment paper, deep-teal ink,
   postcard-style entries with a stamped corner rather than soft SaaS cards.
   ========================================================================== */

:root {
  --paper: #f1ecde;
  --paper-raised: #f8f4e8;
  --ink: #1e2a28;
  --ink-soft: #4a5754;
  --teal: #1f4e4a;
  --teal-deep: #14332f;
  --gold: #d9a441;
  --coral: #c1502e;
  --line: #c9bfa5;
  --line-soft: #ddd5bf;

  --font-display: "Fraunces", "Iowan Old Style", serif;
  --font-body: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

  --radius-sm: 3px;
  --radius-md: 6px;
  --shadow-card: 0 1px 0 var(--line), 2px 3px 0 rgba(30, 42, 40, 0.06);
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

a { color: inherit; }

.wrap {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ---------- Header ---------- */

.site-header {
  border-bottom: 1px solid var(--line);
  background: var(--paper);
  position: sticky;
  top: 0;
  z-index: 20;
}

.site-header .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 18px;
  padding-bottom: 18px;
}

.brand {
  display: flex;
  align-items: baseline;
  gap: 10px;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--teal-deep);
  text-decoration: none;
}

.brand .brand-mark {
  font-size: 1.1rem;
  color: var(--coral);
}

.brand .beta-tag {
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--paper);
  background: var(--coral);
  padding: 2px 7px;
  border-radius: 3px;
  transform: translateY(-6px);
}

.header-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}

.search-input {
  font-family: var(--font-body);
  font-size: 0.9rem;
  border: 1px solid var(--line);
  background: var(--paper-raised);
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  color: var(--ink);
  width: 200px;
}

.search-input:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: 1px;
}

/* ---------- Buttons ---------- */

.btn {
  font-family: var(--font-body);
  font-size: 0.88rem;
  font-weight: 600;
  border: 1px solid var(--teal-deep);
  background: var(--teal-deep);
  color: var(--paper);
  padding: 9px 16px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: transform 0.12s ease, background 0.12s ease;
}

.btn:hover { background: var(--teal); }
.btn:active { transform: translateY(1px); }
.btn:focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }

.btn-outline {
  background: transparent;
  color: var(--teal-deep);
}

.btn-outline:hover { background: rgba(31, 78, 74, 0.08); }

.btn-small { padding: 6px 11px; font-size: 0.8rem; }

/* ---------- Hero ---------- */

.hero {
  padding: 56px 0 40px;
  border-bottom: 1px solid var(--line);
}

.hero-eyebrow {
  font-family: var(--font-body);
  font-size: 0.82rem;
  color: var(--ink-soft);
  margin: 0 0 10px;
}

.hero h1 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(2.1rem, 4vw, 3.3rem);
  line-height: 1.08;
  margin: 0 0 18px;
  max-width: 14ch;
  color: var(--teal-deep);
}

.hero p.lede {
  max-width: 54ch;
  font-size: 1.08rem;
  color: var(--ink-soft);
  margin: 0 0 28px;
}

.hero-stats {
  display: flex;
  gap: 36px;
  flex-wrap: wrap;
}

.hero-stat .num {
  font-family: var(--font-display);
  font-size: 1.9rem;
  color: var(--coral);
  display: block;
  line-height: 1;
}

.hero-stat .label {
  font-size: 0.82rem;
  color: var(--ink-soft);
}

/* ---------- Filter bar ---------- */

.filter-bar {
  padding: 22px 0;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
  border-bottom: 1px solid var(--line-soft);
}

.chip {
  font-family: var(--font-body);
  font-size: 0.84rem;
  border: 1px solid var(--line);
  background: var(--paper-raised);
  color: var(--ink);
  padding: 7px 14px;
  border-radius: 999px;
  cursor: pointer;
}

.chip[aria-pressed="true"] {
  background: var(--teal-deep);
  border-color: var(--teal-deep);
  color: var(--paper);
}

.filter-bar .spacer { flex: 1; }

.sort-select {
  font-family: var(--font-body);
  font-size: 0.84rem;
  border: 1px solid var(--line);
  background: var(--paper-raised);
  padding: 7px 10px;
  border-radius: var(--radius-sm);
  color: var(--ink);
}

/* ---------- Country grid ---------- */

.section { padding: 40px 0; }

.section-heading {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--teal-deep);
  margin: 0 0 4px;
}

.section-sub {
  color: var(--ink-soft);
  font-size: 0.92rem;
  margin: 0 0 24px;
}

.country-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 18px;
}

.postcard {
  position: relative;
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: 20px 18px 18px;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
  color: inherit;
  width: 100%;
}

.postcard:hover { border-color: var(--teal); }
.postcard:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }

.postcard-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10px;
}

.postcard-flag { font-size: 2rem; line-height: 1; }

.wishlist-btn {
  background: none;
  border: none;
  font-size: 1.15rem;
  cursor: pointer;
  color: var(--line);
  padding: 2px;
}

.wishlist-btn[aria-pressed="true"] { color: var(--coral); }
.wishlist-btn:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }

.postcard h3 {
  font-family: var(--font-display);
  font-size: 1.25rem;
  margin: 0 0 4px;
  color: var(--teal-deep);
}

.postcard .meta {
  font-size: 0.8rem;
  color: var(--ink-soft);
  margin: 0 0 10px;
}

.postcard .teaser {
  font-size: 0.9rem;
  color: var(--ink);
  margin: 0 0 14px;
  min-height: 2.7em;
}

.postcard-quickstats {
  display: flex;
  gap: 14px;
  border-top: 1px dashed var(--line);
  padding-top: 10px;
}

.qs {
  font-size: 0.76rem;
  color: var(--ink-soft);
}

.qs strong {
  display: block;
  font-size: 0.98rem;
  color: var(--teal-deep);
  font-weight: 600;
}

.empty-state {
  padding: 40px 20px;
  text-align: center;
  color: var(--ink-soft);
  border: 1px dashed var(--line);
  border-radius: var(--radius-md);
}

/* ---------- Detail panel ---------- */

.detail-panel {
  border-top: 3px solid var(--teal-deep);
  background: var(--paper-raised);
  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  border-radius: 0 0 var(--radius-md) var(--radius-md);
  padding: 30px 28px 34px;
  margin: 0 0 40px;
}

.detail-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 22px;
}

.detail-head h2 {
  font-family: var(--font-display);
  font-size: 2rem;
  margin: 0;
  color: var(--teal-deep);
  display: flex;
  align-items: center;
  gap: 12px;
}

.detail-head .capital-line {
  color: var(--ink-soft);
  font-size: 0.95rem;
  margin-top: 4px;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 32px;
}

@media (max-width: 760px) {
  .detail-grid { grid-template-columns: 1fr; }
  .detail-head { flex-direction: column; }
}

.detail-block { margin-bottom: 26px; }

.detail-block h4 {
  font-family: var(--font-body);
  font-size: 0.78rem;
  letter-spacing: 0.03em;
  color: var(--coral);
  margin: 0 0 12px;
  font-weight: 700;
}

.rating-row {
  display: grid;
  grid-template-columns: 130px 1fr 24px;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
  font-size: 0.85rem;
}

.rating-track {
  height: 7px;
  background: var(--line-soft);
  border-radius: 4px;
  overflow: hidden;
}

.rating-fill {
  height: 100%;
  background: var(--teal);
  border-radius: 4px;
}

.rating-note {
  font-size: 0.76rem;
  color: var(--ink-soft);
  margin-top: 6px;
}

.attraction-item {
  border-bottom: 1px solid var(--line-soft);
  padding: 12px 0;
}

.attraction-item:last-child { border-bottom: none; }

.attraction-item .a-name {
  font-weight: 600;
  color: var(--teal-deep);
}

.attraction-item .a-meta {
  font-size: 0.78rem;
  color: var(--ink-soft);
  margin: 2px 0 4px;
}

.attraction-item .a-blurb {
  font-size: 0.88rem;
  margin: 0;
}

.fact-box {
  background: var(--paper);
  border: 1px dashed var(--line);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  font-size: 0.88rem;
}

.budget-tool {
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 16px;
}

.budget-tool label {
  display: block;
  font-size: 0.8rem;
  color: var(--ink-soft);
  margin-bottom: 6px;
}

.budget-tool input[type="number"] {
  width: 100%;
  font-family: var(--font-body);
  font-size: 0.95rem;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  margin-bottom: 12px;
}

.budget-result {
  font-size: 0.88rem;
  border-top: 1px dashed var(--line);
  padding-top: 10px;
  margin-top: 4px;
}

.budget-result strong { color: var(--teal-deep); }

.cost-tiers {
  display: flex;
  gap: 10px;
  margin-top: 12px;
}

.cost-tier {
  flex: 1;
  text-align: center;
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 8px 4px;
}

.cost-tier .amt {
  display: block;
  font-family: var(--font-display);
  color: var(--teal-deep);
  font-size: 1.05rem;
}

.cost-tier .lbl {
  font-size: 0.7rem;
  color: var(--ink-soft);
}

.detail-close {
  align-self: flex-start;
}

/* ---------- Compare ---------- */

.compare-panel {
  background: var(--teal-deep);
  color: var(--paper);
  border-radius: var(--radius-md);
  padding: 28px;
  margin-bottom: 40px;
}

.compare-panel h2 {
  font-family: var(--font-display);
  margin: 0 0 4px;
  font-size: 1.5rem;
}

.compare-panel .section-sub { color: rgba(241, 236, 222, 0.7); }

.compare-pickers {
  display: flex;
  gap: 16px;
  margin-bottom: 22px;
  flex-wrap: wrap;
}

.compare-pickers select {
  font-family: var(--font-body);
  font-size: 0.9rem;
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(241, 236, 222, 0.35);
  background: var(--teal);
  color: var(--paper);
}

.compare-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.88rem;
}

.compare-table th, .compare-table td {
  text-align: left;
  padding: 10px 12px;
  border-bottom: 1px solid rgba(241, 236, 222, 0.18);
  vertical-align: top;
}

.compare-table th {
  color: rgba(241, 236, 222, 0.65);
  font-weight: 500;
  width: 30%;
}

.compare-table td strong { color: var(--gold); }

/* ---------- Footer ---------- */

.site-footer {
  border-top: 1px solid var(--line);
  padding: 30px 0 50px;
  color: var(--ink-soft);
  font-size: 0.84rem;
}

.site-footer .disclaimer {
  max-width: 62ch;
  margin: 0 0 6px;
}

.visually-hidden {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
